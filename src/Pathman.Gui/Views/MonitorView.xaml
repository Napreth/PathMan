<UserControl xmlns:loc="clr-namespace:Pathman.Gui.Controls" x:Class="Pathman.Gui.Views.MonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pathman.Gui.Controls">
    <Grid>
        <Grid x:Name="SettingsPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{loc:Translate '变量监控'}" Style="{StaticResource PageTitle}" Margin="0,0,0,24"/>
            <ScrollViewer x:Name="MonitorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SettingsPanel" Margin="0,0,4,16">
                    <Border Style="{StaticResource Surface}" Margin="0,0,0,20"><StackPanel>
                        <CheckBox x:Name="EnableMonitoring" Content="{loc:Translate '在后台运行监控程序'}" Style="{StaticResource SettingsToggleSwitch}" Margin="20" Checked="ChangeMonitoring" Unchecked="ChangeMonitoring"/>
                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <CheckBox x:Name="StartupEnabled" Content="{loc:Translate '登录时自动运行后台程序'}" Style="{StaticResource SettingsToggleSwitch}" Margin="20" Checked="ChangeStartup" Unchecked="ChangeStartup"/>
                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <CheckBox x:Name="TrackOrigins" AutomationProperties.Name="{loc:Translate '精确识别修改来源'}" Style="{StaticResource SettingsToggleSwitch}" Margin="20" Checked="ChangeOptions" Unchecked="ChangeOptions"><StackPanel>
                            <TextBlock Text="{loc:Translate '精确识别修改来源'}"/>
                            <TextBlock Text="{loc:Translate '需要管理员权限'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel></CheckBox>
                    </StackPanel></Border>
                    <StackPanel x:Name="MonitoringRules">
                    <TextBlock Text="{loc:Translate '用户变量'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource Surface}" Margin="0,0,0,20"><StackPanel>
                        <CheckBox x:Name="GroupExternalUser" AutomationProperties.Name="{loc:Translate '将外部新用户环境变量归入‘外部变量’分类'}" Style="{StaticResource SettingsToggleSwitch}" Margin="20" Checked="ChangeOptions" Unchecked="ChangeOptions"><StackPanel>
                            <TextBlock Text="{loc:Translate '将外部新环境变量归入‘外部变量’分类'}"/>
                            <TextBlock Text="{loc:Translate '此分类仅在本应用内有效'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel></CheckBox>
                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <CheckBox x:Name="AutoArrangeUser" Content="{loc:Translate '自动整理PATH环境变量'}" AutomationProperties.Name="{loc:Translate '自动整理用户 PATH 环境变量'}" Style="{StaticResource SettingsToggleSwitch}" Margin="20" Checked="ChangeOptions" Unchecked="ChangeOptions"/>
                        <StackPanel x:Name="UserArrangeOptions" Margin="44,0,20,20">
                            <CheckBox x:Name="RemoveUserDuplicates" Content="{loc:Translate '删除外部添加的重复PATH项'}" Margin="0,0,0,14" Checked="ChangeOptions" Unchecked="ChangeOptions"/>
                            <CheckBox x:Name="MoveUserEntries" AutomationProperties.Name="{loc:Translate '将外部添加的PATH项移至EXTERNAL_USER_PATH'}" Checked="ChangeOptions" Unchecked="ChangeOptions"><TextBlock Text="{loc:Translate '将外部添加的PATH项移至EXTERNAL_USER_PATH'}"/></CheckBox>
                            <StackPanel x:Name="UserEditorExclusions" Margin="0,14,0,0">
                                <CheckBox x:Name="IgnoreSystemEditorUser" AutomationProperties.Name="{loc:Translate '不整理系统编辑器修改的变量'}" Checked="ChangeOptions" Unchecked="ChangeOptions" Margin="0,0,0,14"><StackPanel>
                                    <TextBlock Text="{loc:Translate '不整理系统编辑器修改的变量'}"/>
                                    <TextBlock Text="{loc:Translate '此功能需要开启精确识别修改来源'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel></CheckBox>
                                <CheckBox x:Name="IgnorePowerToysUser" AutomationProperties.Name="{loc:Translate '不整理PowerToys修改的变量'}" Checked="ChangeOptions" Unchecked="ChangeOptions"><StackPanel>
                                    <TextBlock Text="{loc:Translate '不整理PowerToys修改的变量'}"/>
                                    <TextBlock Text="{loc:Translate '此功能需要开启精确识别修改来源'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel></CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel></Border>
                    <TextBlock Text="{loc:Translate '系统变量'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource Surface}" Margin="0,0,0,20"><StackPanel>
                        <CheckBox x:Name="GroupExternalMachine" AutomationProperties.Name="{loc:Translate '将外部新系统环境变量归入‘外部变量’分类'}" Style="{StaticResource SettingsToggleSwitch}" Margin="20" Checked="ChangeOptions" Unchecked="ChangeOptions"><StackPanel>
                            <TextBlock Text="{loc:Translate '将外部新环境变量归入‘外部变量’分类'}"/>
                            <TextBlock Text="{loc:Translate '此分类仅在本应用内有效'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel></CheckBox>
                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <CheckBox x:Name="AutoArrangeMachine" AutomationProperties.Name="{loc:Translate '自动整理系统 PATH 环境变量'}" Style="{StaticResource SettingsToggleSwitch}" Margin="20" Checked="ChangeOptions" Unchecked="ChangeOptions"><StackPanel>
                            <TextBlock Text="{loc:Translate '自动整理PATH环境变量'}"/>
                            <TextBlock Text="{loc:Translate '需要管理员权限'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel></CheckBox>
                        <StackPanel x:Name="MachineArrangeOptions" Margin="44,0,20,20">
                            <CheckBox x:Name="RemoveMachineDuplicates" Content="{loc:Translate '删除外部添加的重复PATH项'}" Margin="0,0,0,14" Checked="ChangeOptions" Unchecked="ChangeOptions"/>
                            <CheckBox x:Name="MoveMachineEntries" AutomationProperties.Name="{loc:Translate '将外部添加的PATH项移至EXTERNAL_PATH'}" Checked="ChangeOptions" Unchecked="ChangeOptions"><TextBlock Text="{loc:Translate '将外部添加的PATH项移至EXTERNAL_PATH'}"/></CheckBox>
                            <StackPanel x:Name="MachineEditorExclusions" Margin="0,14,0,0">
                                <CheckBox x:Name="IgnoreSystemEditorMachine" AutomationProperties.Name="{loc:Translate '不整理系统编辑器修改的变量'}" Checked="ChangeOptions" Unchecked="ChangeOptions" Margin="0,0,0,14"><StackPanel>
                                    <TextBlock Text="{loc:Translate '不整理系统编辑器修改的变量'}"/>
                                    <TextBlock Text="{loc:Translate '此功能需要开启精确识别修改来源'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel></CheckBox>
                                <CheckBox x:Name="IgnorePowerToysMachine" AutomationProperties.Name="{loc:Translate '不整理PowerToys修改的变量'}" Checked="ChangeOptions" Unchecked="ChangeOptions"><StackPanel>
                                    <TextBlock Text="{loc:Translate '不整理PowerToys修改的变量'}"/>
                                    <TextBlock Text="{loc:Translate '此功能需要开启精确识别修改来源'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel></CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel></Border>
                    <controls:SettingsLinkCard Content="{loc:Translate '外部更改记录'}" Icon="&#xE81C;" Click="OpenHistory"/>
                    <Border x:Name="MonitorNotice" Style="{StaticResource Surface}" Padding="16" Margin="0,12,0,0" Visibility="Collapsed"><StackPanel>
                        <TextBlock x:Name="MonitorStatus" TextWrapping="Wrap"/>
                        <Button x:Name="ApplyPending" Content="{loc:Translate '授权并整理系统 PATH'}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ApplyPendingChanges" Visibility="Collapsed"/>
                    </StackPanel></Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Translate '外部更改记录'}" Style="{StaticResource PageTitle}"/>
                <Button Grid.Column="1" Content="{loc:Translate '返回'}" Click="CloseHistory"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="4"><Grid>
                <TextBlock x:Name="NoChanges" Text="{loc:Translate '暂无外部更改记录'}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ListView x:Name="Changes" Background="Transparent" BorderThickness="0" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{loc:Translate '外部更改记录'}">
                    <ListView.ItemTemplate><DataTemplate><StackPanel Margin="8,8,8,16">
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProcessText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <ItemsControl ItemsSource="{Binding Diff}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Padding="8,3"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{x:Static controls:SemanticPalette.Red}"/><Style.Triggers><DataTrigger Binding="{Binding IsAdded}" Value="True"><Setter Property="Background" Value="{x:Static controls:SemanticPalette.Green}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="{Binding Text}" Foreground="#242424" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Expander Header="{loc:Translate '查看详情'}" Margin="0,8,0,0"><Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:Translate '更改前'}" Margin="0,0,0,4"/><TextBox Text="{Binding Before, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:Translate '更改后'}" Margin="0,0,0,4"/><TextBox Text="{Binding After, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto"/></StackPanel>
                        </Grid></Expander>
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
