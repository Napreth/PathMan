<UserControl xmlns:loc="clr-namespace:Pathman.Gui.Controls" x:Class="Pathman.Gui.Views.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pathman.Gui.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="{loc:Translate '关于'}" Style="{StaticResource PageTitle}" Margin="0,0,0,24"/>
        <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image x:Name="AppIcon" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="PathMan" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" FontSize="16" Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Text="{loc:Translate 'Windows 环境变量与程序别名管理器'}" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
        </Grid>
        <controls:SettingsLinkCard x:Name="SourceCodeLink" Content="{loc:Translate '源代码'}" Detail="Napreth/PathMan" Icon="&#xE943;" Click="OpenSource" Margin="0,0,0,4"/>
        <Border Style="{StaticResource Surface}" Padding="20,16" Margin="0,0,0,4">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{loc:Translate '更新'}"/><TextBlock x:Name="UpdateStatus" FontSize="12" FontWeight="Normal" Margin="0,4,16,0" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ReleaseLink" Content="{loc:Translate '查看新版'}" Click="OpenRelease" Margin="0,0,8,0" Visibility="Collapsed"/><Button x:Name="CheckUpdatesButton" Content="{loc:Translate '检查更新'}" Click="CheckUpdates"/></StackPanel>
            </Grid>
        </Border>
        <controls:SettingsLinkCard x:Name="LicenseLink" Content="{loc:Translate '许可证'}" Detail="MIT license" Icon="&#xE8A5;" Click="ShowLicense"/>
    </StackPanel></ScrollViewer>
</UserControl>
