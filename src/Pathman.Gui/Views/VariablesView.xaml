<UserControl x:Class="Pathman.Gui.Views.VariablesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pathman.Gui"
        xmlns:controls="clr-namespace:Pathman.Gui.Controls" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <DataTemplate x:Key="DiffCellTemplate">
            <Grid MinHeight="24">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Background" Value="Transparent"/><Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdded}" Value="True"><Setter Property="Background" Value="{x:Static controls:SemanticPalette.Green}"/><Setter Property="TextElement.Foreground" Value="#242424"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsRemoved}" Value="True"><Setter Property="Background" Value="{x:Static controls:SemanticPalette.Red}"/><Setter Property="TextElement.Foreground" Value="#242424"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Background" Value="#08000000"/></DataTrigger>
                </Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontSize="12" Opacity=".55" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Prefix}" FontFamily="Consolas" VerticalAlignment="Center"/>
                <controls:ReferenceText Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" Margin="0,2,8,2" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource CompactTreeItem}"/>
        <Style TargetType="TreeView" BasedOn="{StaticResource DefaultTreeViewStyle}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:EnvironmentTreeNode}" ItemsSource="{Binding Children}">
            <controls:EditableRow x:Name="NodeRow" Text="{Binding Title}" CanDelete="{Binding CanDelete}" IsPinned="{Binding IsPinned}"
                                  EditRequested="RowEditRequested" DeleteRequested="RowDeleteRequested" PinRequested="RowPinRequested" EditingChanged="RowEditingChanged"/>
            <HierarchicalDataTemplate.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter TargetName="NodeRow" Property="FontFamily" Value="{StaticResource SettingsChineseFont}"/></DataTrigger></HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PreviewItems" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter>
            </Style></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CleanupButton" Content="清理" Click="PreviewCleanup" Padding="16,5" Margin="0,0,8,0"/><Button x:Name="RefreshButton" Content="刷新" Click="Refresh" Padding="16,5"/></StackPanel><TextBlock Text="变量管理" Style="{StaticResource PageTitle}"/></DockPanel>
        <Grid x:Name="EditorPanel" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,6"><TextBlock x:Name="UserTitle" Text="用户变量" Style="{StaticResource SectionTitle}"/><controls:ScopeActions x:Name="UserActions" Scope="User" HorizontalAlignment="Right" VerticalAlignment="Center" ActionRequested="ScopeActionRequested" AutomationProperties.Name="用户变量操作"/></Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="96"/><RowDefinition Height="16"/><RowDefinition Height="1.5*" MinHeight="132"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Surface}"><TreeView x:Name="UserVariablesTree" SelectedItemChanged="SelectVariable" AutomationProperties.Name="用户变量"
                    PreviewMouseLeftButtonDown="TreeMouseDown" PreviewMouseMove="TreeMouseMove" PreviewMouseLeftButtonUp="TreeMouseUp" PreviewKeyDown="TreeKeyDown"/></Border>
                <GridSplitter x:Name="ScopeSplitter" Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" Focusable="True" KeyboardIncrement="8"
                              AutomationProperties.Name="调整用户和系统变量区域大小" ToolTip="拖动调整用户变量和系统变量的高度">
                    <GridSplitter.Template><ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent"><Border x:Name="Line" Height="1" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></GridSplitter.Template>
                </GridSplitter>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6"><TextBlock x:Name="SystemTitle" Text="系统变量" Style="{StaticResource SectionTitle}"/><controls:ScopeActions x:Name="SystemActions" Scope="Machine" HorizontalAlignment="Right" VerticalAlignment="Center" ActionRequested="ScopeActionRequested" AutomationProperties.Name="系统变量操作"/></Grid>
                    <Border Grid.Row="1" Style="{StaticResource Surface}"><TreeView x:Name="SystemVariablesTree" SelectedItemChanged="SelectVariable" AutomationProperties.Name="系统变量"
                        PreviewMouseLeftButtonDown="TreeMouseDown" PreviewMouseMove="TreeMouseMove" PreviewMouseLeftButtonUp="TreeMouseUp" PreviewKeyDown="TreeKeyDown"/></Border>
                </Grid>
            </Grid>
            <TextBlock x:Name="VariableTitle" Grid.Column="2" Text="环境变量" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <Border x:Name="ValueSurface" Grid.Row="1" Grid.Column="2" Style="{StaticResource Surface}">
                <Grid>
                    <TextBlock x:Name="EmptySelection" Text="选择环境变量" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ListBox x:Name="ValuesList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="4" FontSize="13" SelectionChanged="EntrySelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="变量条目"
                             PreviewMouseLeftButtonDown="PathMouseDown" PreviewMouseMove="PathMouseMove" PreviewMouseLeftButtonUp="PathMouseUp">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CompactListItem}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/><Style.Triggers><DataTrigger Binding="{Binding IsDragPlaceholder}" Value="True"><Setter Property="Opacity" Value="0"/></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="{Binding Indent}"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button IsEnabled="{Binding CanExpand}" Click="TogglePathReference" Focusable="False" ToolTip="{Binding GroupToolTip}" AutomationProperties.Name="{Binding ExpandActionName}">
                                <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"/></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <controls:EditableRow Grid.Column="1" Text="{Binding Value}" ShowPin="False" ShowEdit="False" ShowDelete="False" ShowJump="{Binding HasReferences}" JumpToolTip="{Binding ReferenceToolTip}" JumpRequested="EntryJumpRequested" EditRequested="EntryEditRequested" EditingCanceled="EntryEditCanceled" EditingChanged="RowEditingChanged"/>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="GroupVariablesList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="分组变量">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CompactListItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <controls:EditableRow Text="{Binding Title}" Detail="{Binding Variable.RawValue}" CanDelete="{Binding CanDelete}" IsPinned="{Binding IsPinned}" EditOnDoubleClick="False" Activated="OpenGroupVariable" EditRequested="RowEditRequested" DeleteRequested="RowDeleteRequested" PinRequested="RowPinRequested" EditingChanged="RowEditingChanged"/>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <controls:ReferenceTextBox x:Name="ScalarValueBox" Style="{StaticResource ValueTextBox}" Visibility="Collapsed" TextChanged="ValueTextChanged" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="变量值"/>
                </Grid>
            </Border>
            <Grid x:Name="ValueActions" Grid.Row="1" Grid.Column="4" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel x:Name="ListButtons">
                        <Button x:Name="AddEntryButton" Content="新建" Style="{StaticResource Action}" Click="AddEntry" AutomationProperties.Name="新建条目"/>
                        <Button x:Name="EditEntryButton" Content="编辑" Style="{StaticResource Action}" Click="EditEntry"/>
                        <Button Content="浏览…" Style="{StaticResource Action}" Click="BrowseEntry"/>
                        <Button x:Name="MoveUpButton" Content="上移" Style="{StaticResource Action}" Click="MoveUp" Margin="0,16,0,8"/>
                        <Button x:Name="MoveDownButton" Content="下移" Style="{StaticResource Action}" Click="MoveDown"/>
                    </StackPanel>
                    <Button x:Name="CopyValueButton" Content="复制" Style="{StaticResource Action}" Click="CopyValue"/>
                    <Button x:Name="DeleteEntryButton" Content="删除" Style="{StaticResource Action}" Click="DeleteEntry" ToolTip="删除选中条目"/>
                </StackPanel>
                <StackPanel Grid.Row="2"><Button x:Name="ToggleModeButton" Content="文本模式" Style="{StaticResource Action}" Click="ToggleValueMode" Margin="0,0,0,16"/><Button x:Name="SaveButton" Content="保存" Style="{StaticResource Action}" Click="SaveValue"/><Button x:Name="RevertButton" Content="撤销" Style="{StaticResource Action}" Click="RevertValue" Margin="0"/></StackPanel>
            </Grid>
        </Grid>
        <Grid x:Name="CleanupPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16"><Button Content="返回" DockPanel.Dock="Right" Click="CloseCleanup"/><TextBlock Text="清理预览" Style="{StaticResource SectionTitle}"/></DockPanel>
            <ScrollViewer x:Name="CleanupScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PreviewMouseWheel="ScrollCleanup">
                <StackPanel>
                    <ListBox x:Name="CleanupChanges" Style="{StaticResource PreviewItems}" AutomationProperties.Name="待清理的变量"><ListBox.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Surface}" Margin="0,0,0,12"><StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" Padding="16,12"/>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="修改前" Margin="16,0,0,4" Opacity=".65"/><TextBlock Grid.Column="1" Text="修改后" Margin="16,0,0,4" Opacity=".65"/></Grid>
                            <ListBox ItemsSource="{Binding Lines}" Style="{StaticResource PreviewItems}" Margin="0,0,0,8"><ListBox.ItemTemplate><DataTemplate>
                                <Grid x:Name="DiffRow" MinHeight="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ContentControl x:Name="BeforeCell" Content="{Binding Before}" ContentTemplate="{StaticResource DiffCellTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" AutomationProperties.Name="修改前"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                    <ContentControl x:Name="AfterCell" Grid.Column="2" Content="{Binding After}" ContentTemplate="{StaticResource DiffCellTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" AutomationProperties.Name="修改后"/>
                                    <TextBlock x:Name="HunkHeader" Grid.ColumnSpan="3" Text="{Binding Hunk}" Background="{x:Static controls:SemanticPalette.Blue}" Foreground="#242424" FontFamily="Consolas" Padding="16,3" Visibility="Collapsed"/>
                                </Grid>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding IsHunk}" Value="True"><Setter TargetName="HunkHeader" Property="Visibility" Value="Visible"/><Setter TargetName="BeforeCell" Property="Visibility" Value="Collapsed"/><Setter TargetName="AfterCell" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
                            </DataTemplate></ListBox.ItemTemplate></ListBox>
                        </StackPanel></Border>
                    </DataTemplate></ListBox.ItemTemplate></ListBox>
                    <TextBlock x:Name="CleanupEmpty" Text="没有需要清理的条目" Margin="0,8,0,20"/>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="ApplyCleanupButton" DockPanel.Dock="Right" Content="应用清理" Click="ApplyCleanup" Padding="16,6"/><TextBlock x:Name="CleanupStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
