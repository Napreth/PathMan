<Window x:Class="Pathman.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PathMan" Width="1280" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Margin="12,24,8,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="12,0,0,24"><TextBlock Text="PathMan" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="pre-alpha" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
            <ListBox x:Name="Navigation" Grid.Row="1" SelectionChanged="Navigate" Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="0" AutomationProperties.Name="导航">
                <ListBoxItem Tag="variables" AutomationProperties.Name="变量管理"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="变量管理"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="aliases" AutomationProperties.Name="程序别名"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="程序别名"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="monitor" AutomationProperties.Name="变量监控"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="变量监控"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="about" AutomationProperties.Name="关于"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="关于"/></StackPanel></ListBoxItem>
            </ListBox>
        </Grid>
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="20,22,24,18" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
