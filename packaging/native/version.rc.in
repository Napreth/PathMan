#include <winver.h>
1 VERSIONINFO
FILEVERSION @PATHMAN_VERSION_TUPLE@
PRODUCTVERSION @PATHMAN_VERSION_TUPLE@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @PATHMAN_FILE_TYPE@
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PathMan\0"
            VALUE "FileDescription", "@PATHMAN_BINARY_NAME@\0"
            VALUE "FileVersion", "@PATHMAN_VERSION_NUMBER@.0\0"
            VALUE "ProductName", "PathMan\0"
            VALUE "ProductVersion", "@PATHMAN_VERSION_NAME@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
