<Window xmlns:loc="clr-namespace:Pathman.Gui.Controls" x:Class="Pathman.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Pathman.Gui.Controls"
        Title="PathMan" Icon="Assets/PathMan.ico" Width="1280" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource SettingsTextFont}" FontSize="14"
        FontWeight="Normal" Language="zh-CN" UseLayoutRounding="True" Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="WindowTitle" Text="PathMan" FontSize="13" VerticalAlignment="Center" Margin="16,0,150,0" IsHitTestVisible="False"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Margin="16,0,12,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="12,24,0,28" Height="56">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Left">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#52B7FF" Offset="0"/><GradientStop Color="#0860CB" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Image Source="{StaticResource VariablesIcon}" Width="30" Height="30"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="PathMan" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AppVersion" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="Navigation" Grid.Row="1" SelectionChanged="Navigate" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavigationItem}" SelectedIndex="0" AutomationProperties.Name="{loc:Translate '导航'}">
                    <ListBoxItem Tag="variables" AutomationProperties.Name="{loc:Translate '变量管理'}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource VariablesIcon}" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{loc:Translate '变量管理'}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="health" AutomationProperties.Name="{loc:Translate '健康检测'}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource HealthIcon}" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{loc:Translate '健康检测'}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="aliases" AutomationProperties.Name="{loc:Translate '程序别名'}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource AliasesIcon}" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{loc:Translate '程序别名'}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="versions" AutomationProperties.Name="{loc:Translate '版本管理'}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource VersionsIcon}" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{loc:Translate '版本管理'}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="monitor" AutomationProperties.Name="{loc:Translate '变量监控'}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource MonitorIcon}" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{loc:Translate '变量监控'}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="settings" AutomationProperties.Name="{loc:Translate '设置'}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="20" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="{loc:Translate '设置'}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="about" AutomationProperties.Name="{loc:Translate '关于'}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource AboutIcon}" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{loc:Translate '关于'}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                </ListBox>
                <ListBox x:Name="NotificationsList" Grid.Row="2" ItemsSource="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,16,0,0" VerticalAlignment="Bottom" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Translate '通知'}">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Background}" CornerRadius="8" Padding="12" Margin="0,0,0,8" TextElement.Foreground="#242424">
                        <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource SettingsIconButton}" Foreground="#242424" Width="20" Height="20" Click="DismissNotification" ToolTip="{loc:Translate '关闭通知'}" AutomationProperties.Name="{loc:Translate '关闭通知'}"/><TextBlock Text="{Binding Title}" Foreground="#242424" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><controls:Osc8TextBlock Body="{Binding Body}" FontSize="13" Foreground="#242424" Margin="0,8,0,0"/></StackPanel>
                    </Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24,24,28,18" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}"/>
        </Grid>
    </Grid>
</Window>
