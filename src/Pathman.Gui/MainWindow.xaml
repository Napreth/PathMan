<Window x:Class="Pathman.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PathMan" Width="860" Height="540" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PathMan" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Windows 环境变量与程序别名管理器" Margin="0,6,0,18" Foreground="#536176"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock x:Name="BinPath" TextWrapping="Wrap"/>
            <TextBlock x:Name="ShimsPath" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <GroupBox Grid.Row="2" Header="程序别名" Padding="12" Background="White">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="刷新" Click="RefreshAliases" Padding="20,6"
                        HorizontalAlignment="Right" Margin="0,12,0,0"/>
                <DataGrid x:Name="Aliases" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="别名" Binding="{Binding Name}" Width="160"/>
                        <DataGridTextColumn Header="目标程序" Binding="{Binding Target}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <CheckBox x:Name="StartupEnabled" Content="登录 Windows 时自动启动 PathMan 后台程序"
                      Click="ChangeStartup"/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#536176"
                       Text="当前为架构骨架。可使用 bin\pathman.exe shim add 创建别名；环境变量编辑、分组、版本切换和自动监控尚未实现。"/>
        </StackPanel>
    </Grid>
</Window>
