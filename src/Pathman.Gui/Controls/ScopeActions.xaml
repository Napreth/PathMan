<UserControl x:Class="Pathman.Gui.Controls.ScopeActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="NewButton" Style="{StaticResource SettingsIconButton}" AutomationProperties.Name="新建" ToolTip="新建" Click="OpenMenu">
        <Grid Width="24" Height="22"><TextBlock Text="&#xE710;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
        <Button.ContextMenu>
            <ContextMenu x:Name="NewMenu" Placement="Custom" MinWidth="184" FontSize="13" FontFamily="{StaticResource SettingsChineseFont}">
                <MenuItem Header="新建分组" Click="NewGroup" AutomationProperties.Name="新建分组">
                    <MenuItem.Icon><TextBlock Text="&#xE8F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="新建环境变量" Click="NewVariable" AutomationProperties.Name="新建环境变量">
                    <MenuItem.Icon><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Button.ContextMenu>
    </Button>
</UserControl>
