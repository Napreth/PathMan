<UserControl x:Class="Pathman.Gui.Views.MonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="变量监控" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,22"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,20"><CheckBox x:Name="EnableMonitoring" Content="监控环境变量的外部更改" Checked="ChangeMonitoring" Unchecked="ChangeMonitoring"/><TextBlock Text="记录新增、修改和删除，启用后显示“外部变量”分类。" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="MonitorStatus" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
        <ListView x:Name="Changes" Grid.Row="2" Background="{DynamicResource CardBackground}" AutomationProperties.Name="变量变更记录"><ListView.View><GridView><GridViewColumn Header="时间" DisplayMemberBinding="{Binding TimeText}" Width="150"/><GridViewColumn Header="作用域" DisplayMemberBinding="{Binding ScopeText}" Width="90"/><GridViewColumn Header="变量名" DisplayMemberBinding="{Binding Name}" Width="240"/><GridViewColumn Header="操作" DisplayMemberBinding="{Binding ActionText}" Width="90"/><GridViewColumn Header="来源" DisplayMemberBinding="{Binding Source}" Width="120"/></GridView></ListView.View></ListView>
    </Grid>
</UserControl>
