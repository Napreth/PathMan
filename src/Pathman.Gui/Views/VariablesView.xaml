<UserControl x:Class="Pathman.Gui.Views.VariablesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pathman.Gui">
    <UserControl.Resources>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
        </Style>
        <Style TargetType="TreeView" BasedOn="{StaticResource DefaultTreeViewStyle}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:EnvironmentTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock x:Name="NodeText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,2" ToolTip="{Binding Title}"/>
            <HierarchicalDataTemplate.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter TargetName="NodeText" Property="FontWeight" Value="SemiBold"/></DataTrigger></HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="IconAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Click="Refresh" Padding="14,6"/><TextBlock Text="变量管理" FontSize="24" FontWeight="SemiBold"/></DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="106"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="16"/><RowDefinition Height="32"/><RowDefinition Height="1.5*" MinHeight="170"/></Grid.RowDefinitions>
            <TextBlock Text="用户变量" VerticalAlignment="Top"/>
            <Border Grid.Row="1" Style="{StaticResource Surface}" CornerRadius="4"><TreeView x:Name="UserVariablesTree" SelectedItemChanged="SelectVariable" AutomationProperties.Name="用户变量"/></Border>
            <TextBlock Grid.Row="3" Text="系统变量" VerticalAlignment="Top"/>
            <Border Grid.Row="4" Style="{StaticResource Surface}" CornerRadius="4"><TreeView x:Name="SystemVariablesTree" SelectedItemChanged="SelectVariable" AutomationProperties.Name="系统变量"/></Border>
            <Grid Grid.Column="2" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="VariableTitle" Text="环境变量" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                <StackPanel x:Name="SelectionActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="DeleteVariableButton" Style="{StaticResource IconAction}" Content="&#xE74D;" Click="DeleteSelection" ToolTip="删除" AutomationProperties.Name="删除"/>
                    <Button x:Name="RenameVariableButton" Style="{StaticResource IconAction}" Content="&#xE70F;" Click="RenameSelection" ToolTip="重命名" AutomationProperties.Name="重命名"/>
                    <Grid MouseEnter="ShowNewMenu" MouseLeave="CloseNewMenu">
                        <Button x:Name="NewButton" Style="{StaticResource IconAction}" Click="OpenNewMenu" AutomationProperties.Name="新建">
                            <Grid Width="24" Height="22"><TextBlock Text="&#xE710;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                        </Button>
                        <Popup x:Name="NewMenuPopup" PlacementTarget="{Binding ElementName=NewButton}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" MouseLeave="CloseNewMenu">
                                <StackPanel><Button Content="新建分组" Click="NewGroup" HorizontalAlignment="Stretch" Padding="14,7" AutomationProperties.Name="新建分组"/><Button Content="新建环境变量" Click="NewVariable" HorizontalAlignment="Stretch" Padding="14,7" AutomationProperties.Name="新建环境变量"/></StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
            <Border x:Name="ValueSurface" Grid.Row="1" Grid.RowSpan="4" Grid.Column="2" Style="{StaticResource Surface}" CornerRadius="4">
                <Grid>
                    <TextBlock x:Name="EmptySelection" Text="选择环境变量" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ListBox x:Name="ValuesList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="2" SelectionChanged="EntrySelected" MouseDoubleClick="EditEntry" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="变量条目">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}"><Setter Property="Padding" Value="6,4"/><Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" FontFamily="Consolas" MinHeight="20"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox x:Name="ScalarValueBox" Visibility="Collapsed" TextChanged="ValueTextChanged" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="10" FontFamily="Consolas" AutomationProperties.Name="变量值"/>
                </Grid>
            </Border>
            <Grid x:Name="ValueActions" Grid.Row="1" Grid.RowSpan="4" Grid.Column="4" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel x:Name="ListButtons">
                        <Button Content="新建" Style="{StaticResource Action}" Click="AddEntry" AutomationProperties.Name="新建条目"/>
                        <Button x:Name="EditEntryButton" Content="编辑" Style="{StaticResource Action}" Click="EditEntry"/>
                        <Button Content="浏览…" Style="{StaticResource Action}" Click="BrowseEntry"/>
                        <Button x:Name="DeleteEntryButton" Content="删除" Style="{StaticResource Action}" Click="RemoveEntry" AutomationProperties.Name="删除条目"/>
                        <Button x:Name="MoveUpButton" Content="上移" Style="{StaticResource Action}" Click="MoveUp" Margin="0,16,0,8"/>
                        <Button x:Name="MoveDownButton" Content="下移" Style="{StaticResource Action}" Click="MoveDown"/>
                    </StackPanel>
                    <Button Content="编辑文本…" Style="{StaticResource Action}" Click="EditText" Margin="0,16,0,8"/>
                    <Button Content="复制" Style="{StaticResource Action}" Click="CopyValue"/>
                </StackPanel>
                <StackPanel Grid.Row="2"><Button x:Name="SaveButton" Content="保存" Style="{StaticResource Action}" Click="SaveValue"/><Button x:Name="RevertButton" Content="撤销" Style="{StaticResource Action}" Click="RevertValue" Margin="0"/></StackPanel>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
