<UserControl x:Class="Pathman.Gui.Controls.EditableRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pathman.Gui.Controls"
             x:Name="Root" Focusable="False" MouseDoubleClick="DoubleClick" PreviewKeyDown="RowKeyDown">
    <Grid Height="24" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,4,0">
            <Grid x:Name="Label"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NameColumn" Width="3*"/><ColumnDefinition x:Name="DetailColumn" Width="2*"/></Grid.ColumnDefinitions>
                <controls:ReferenceText x:Name="NameLabel" Text="{Binding Text, ElementName=Root}" VerticalAlignment="Center" ToolTip="{Binding Text, ElementName=Root}"/>
                <TextBlock Text="（空条目）" Opacity=".5" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text,ElementName=Root}" Value=""/><Condition Binding="{Binding ShowPin,ElementName=Root}" Value="False"/><Condition Binding="{Binding ShowDelete,ElementName=Root}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <controls:ReferenceText x:Name="DetailLabel" Grid.Column="1" Text="{Binding Detail, ElementName=Root}" Margin="12,0,0,0" Opacity=".65" VerticalAlignment="Center" ToolTip="{Binding Detail, ElementName=Root}"/>
            </Grid>
            <controls:ReferenceTextBox x:Name="Input" Visibility="Collapsed" Padding="2,0" MinHeight="0" Height="23" FontSize="13"
                     VerticalContentAlignment="Center" BorderThickness="1" AutomationProperties.Name="行内编辑"
                     PreviewKeyDown="InputKeyDown" LostKeyboardFocus="InputLostFocus"/>
        </Grid>
        <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="PinButton" Content="&#xE718;" ToolTip="置顶" AutomationProperties.Name="置顶" Click="Pin"/>
            <Button x:Name="EditButton" Content="&#xE70F;" ToolTip="重命名" AutomationProperties.Name="编辑" Click="Edit"/>
            <Button x:Name="DeleteButton" Content="&#xE74D;" ToolTip="删除" AutomationProperties.Name="删除" Click="Delete" IsEnabled="{Binding CanDelete, ElementName=Root}"/>
            <Button x:Name="JumpButton" Content="&#xE8A7;" Visibility="Collapsed" ToolTip="{Binding JumpToolTip, ElementName=Root}" AutomationProperties.Name="转到引用变量" Click="Jump"/>
        </StackPanel>
    </Grid>
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SettingsIconButton}">
            <Setter Property="Width" Value="23"/><Setter Property="Height" Value="22"/><Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{Binding Foreground, ElementName=Root}"/>
        </Style>
    </UserControl.Resources>
</UserControl>
