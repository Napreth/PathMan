<Window xmlns:loc="clr-namespace:Pathman.Gui.Controls" x:Class="Pathman.Gui.AliasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Translate '程序别名 · PathMan'}" Width="760" Height="480" MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="{loc:Translate '刷新'}" Click="RefreshAliases" Padding="16,6"/>
            <TextBlock Text="{loc:Translate '程序别名'}" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="8">
            <ListView x:Name="Aliases" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View><GridView><GridViewColumn Header="{loc:Translate '别名'}" DisplayMemberBinding="{Binding Name}" Width="150"/><GridViewColumn Header="{loc:Translate '目标程序'}" DisplayMemberBinding="{Binding Target}" Width="470"/></GridView></ListView.View>
            </ListView>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="BinPath" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
            <TextBlock x:Name="ShimsPath" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
