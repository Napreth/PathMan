<UserControl x:Class="Pathman.Gui.Views.AliasesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Content="刷新" Click="Refresh" Padding="16,5" VerticalAlignment="Center"/><TextBlock Text="程序别名" Style="{StaticResource PageTitle}"/></DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="20,16" Margin="0,0,0,12"><StackPanel><CheckBox x:Name="EnableAliases" Content="启用程序别名" Style="{StaticResource SettingsToggleSwitch}" Checked="ChangeEnabled" Unchecked="ChangeEnabled"/><TextBlock x:Name="AliasStatus" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource Surface}" Padding="4"><ListView x:Name="Aliases" Background="Transparent" BorderThickness="0" FontSize="13" AutomationProperties.Name="程序别名列表"><ListView.View><GridView><GridViewColumn Header="别名" DisplayMemberBinding="{Binding Name}" Width="180"/><GridViewColumn Header="目标程序" DisplayMemberBinding="{Binding Target}" Width="570"/></GridView></ListView.View></ListView></Border>
        <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="BinPath" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="ShimsPath" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
    </Grid>
</UserControl>
