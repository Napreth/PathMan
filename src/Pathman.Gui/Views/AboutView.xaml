<UserControl x:Class="Pathman.Gui.Views.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel><TextBlock Text="关于" Style="{StaticResource PageTitle}" Margin="0,0,0,24"/><Border Style="{StaticResource Surface}" Padding="24"><StackPanel><TextBlock Text="PathMan" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/><TextBlock Text="Windows 环境变量与程序别名管理器" Margin="0,18,0,0"/><TextBlock Text="MIT License" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Border><Border Style="{StaticResource Surface}" Padding="20,16" Margin="0,12,0,0"><CheckBox x:Name="StartupEnabled" Content="登录时启动后台" Checked="ChangeStartup" Unchecked="ChangeStartup"/></Border><TextBlock x:Name="ConfigPath" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,20,0,0"/></StackPanel>
</UserControl>
