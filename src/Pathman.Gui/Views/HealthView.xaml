<UserControl x:Class="Pathman.Gui.Views.HealthView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pathman.Gui.Controls">
    <UserControl.Resources>
        <Style x:Key="HealthItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="HealthItems" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource HealthItem}"/>
        </Style>
        <Style x:Key="HealthAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="8,4,0,0"/><Setter Property="FontSize" Value="13"/></Style>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24"><Button x:Name="ScanButton" DockPanel.Dock="Right" Content="重新检测" Click="Scan" Padding="16,5"/><TextBlock Text="健康检测" Style="{StaticResource PageTitle}"/></DockPanel>
        <Border x:Name="SummarySurface" Grid.Row="1" Style="{StaticResource Surface}" Padding="20,16" Margin="0,0,0,16"><DockPanel><CheckBox x:Name="ShowIgnored" DockPanel.Dock="Right" Content="显示已忽略" Visibility="Collapsed" VerticalAlignment="Center" Checked="ShowIgnoredChanged" Unchecked="ShowIgnoredChanged"/><StackPanel><TextBlock x:Name="Summary" Text="正在检测…" FontSize="18"/><TextBlock x:Name="ScanTime" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel></DockPanel></Border>
        <ScrollViewer x:Name="HealthScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PreviewMouseWheel="ScrollHealth">
            <ListBox x:Name="IssueGroups" Style="{StaticResource HealthItems}">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HealthItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Surface}" Padding="20,16" Margin="0,0,0,12"><StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" Margin="0,0,0,12"/>
                    <ListBox ItemsSource="{Binding Issues}" Style="{StaticResource HealthItems}">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HealthItem}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Symbol}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <controls:Osc8TextBlock Body="{Binding Body}" FontSize="14"/>
                                <controls:ReferenceText Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"/>
                                <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ListBox ItemsSource="{Binding Locations}" Style="{StaticResource HealthItems}" Margin="0,8,0,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HealthItem}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6"><StackPanel>
                                        <controls:Osc8TextBlock Body="{Binding Body}" FontSize="12" Margin="0,0,0,6"/>
                                        <controls:ReferenceText Text="{Binding Previous}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <controls:ReferenceText Text="{Binding Current}" TextWrapping="Wrap" FontSize="12" Margin="0,4"/>
                                        <controls:ReferenceText Text="{Binding Next}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel></Border>
                                </DataTemplate></ListBox.ItemTemplate></ListBox>
                                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="查看详情" Style="{StaticResource HealthAction}" Margin="0,4,0,0" Click="ShowDetails" VerticalAlignment="Top"/>
                                    <DockPanel Grid.Column="1" LastChildFill="False" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button DockPanel.Dock="Left" Content="{Binding IgnoreLabel}" Style="{StaticResource HealthAction}" VerticalAlignment="Top" Click="Ignore"/>
                                        <ListBox ItemsSource="{Binding Fixes}" Style="{StaticResource HealthItems}" HorizontalAlignment="Right"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HealthItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Button AutomationProperties.Name="{Binding Label}" Style="{StaticResource HealthAction}" Click="Fix"><TextBlock Text="{Binding Label}"/></Button></DataTemplate></ListBox.ItemTemplate></ListBox>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate></ListBox>
                </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        <UserControl x:Name="DetailsPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" AutomationProperties.Name="问题详情"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="返回" Click="CloseDetails"/><TextBlock Text="问题详情" FontSize="18" VerticalAlignment="Center"/></DockPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,16"><controls:ReferenceText x:Name="DetailMessage" TextWrapping="Wrap" FontSize="14"/><TextBlock x:Name="DetailSuggestion" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" FontSize="13"/></StackPanel>
            <Grid Grid.Row="2" x:Name="DetailBody"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Surface}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollHealth">
                    <ListBox x:Name="RelatedVariables" Style="{StaticResource HealthItems}" Padding="12" AutomationProperties.Name="相关环境变量">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HealthItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,16"><controls:Osc8TextBlock Body="{Binding Body}" FontSize="14" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding Entries}" Style="{StaticResource HealthItems}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HealthItem}"><Setter Property="AutomationProperties.Name" Value="{Binding}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><controls:ReferenceText Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="8,3" MinHeight="20"/></DataTemplate></ListBox.ItemTemplate></ListBox>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer></Border>
                <UserControl Grid.Column="2" x:Name="DetailActions" AutomationProperties.Name="问题操作"><StackPanel>
                    <Button Content="{Binding IgnoreLabel}" Click="Ignore" Margin="0,0,0,8" Padding="12,5"/>
                    <ListBox ItemsSource="{Binding Fixes}" Style="{StaticResource HealthItems}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HealthItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Button Click="Fix" Margin="0,0,0,8" Padding="12,5" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding Label}"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></Button></DataTemplate></ListBox.ItemTemplate></ListBox>
                </StackPanel></UserControl>
            </Grid>
        </Grid></UserControl>
        <TextBlock x:Name="ActionStatus" Grid.Row="3" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
