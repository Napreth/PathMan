<UserControl x:Class="Pathman.Gui.Views.AliasesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pathman.Gui.Controls">
    <UserControl.Resources><Style x:Key="AliasAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="13"/></Style></UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24"><Button x:Name="RefreshAliasesButton" DockPanel.Dock="Right" Content="刷新" Click="Refresh" Padding="16,5"/><TextBlock Text="程序别名" Style="{StaticResource PageTitle}"/></DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="20,16" Margin="0,0,0,16"><StackPanel><CheckBox x:Name="EnableAliases" Content="启用程序别名" Style="{StaticResource SettingsToggleSwitch}" Checked="ChangeEnabled" Unchecked="ChangeEnabled"/><TextBlock Text="此功能将在用户PATH中添加垫片目录" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Surface}"><ListBox x:Name="Aliases" Background="Transparent" BorderThickness="0" Padding="4" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SelectedAliasChanged" AutomationProperties.Name="程序别名列表">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CompactListItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><controls:EditableRow Text="{Binding Name}" Detail="{Binding Target}" NameWidth="180" CanEdit="{Binding CanEdit}" ShowPin="False" ShowEdit="False" ShowDelete="False" EditOnDoubleClick="False" Activated="EditAliasRow" EditRequested="AliasEditRequested" EditingChanged="AliasEditingChanged" EditingCanceled="AliasEditCanceled"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox></Border>
            <StackPanel Grid.Column="2"><Button x:Name="NewAliasButton" Content="新建" Style="{StaticResource AliasAction}" Click="NewAlias"/><Button x:Name="RenameAliasButton" Content="重命名" Style="{StaticResource AliasAction}" Click="RenameAlias"/><Button x:Name="EditAliasButton" Content="编辑" Style="{StaticResource AliasAction}" Click="EditAlias"/><Button x:Name="BrowseAliasButton" Content="浏览…" Style="{StaticResource AliasAction}" Click="BrowseAlias"/><Button x:Name="CopyAliasButton" Content="复制" Style="{StaticResource AliasAction}" Click="CopyAlias" ToolTip="复制别名；右键可复制目标路径"><Button.ContextMenu><ContextMenu><MenuItem Header="复制别名" Click="CopyAlias"/><MenuItem Header="复制目标路径" Click="CopyTarget"/></ContextMenu></Button.ContextMenu></Button><Button x:Name="DeleteAliasButton" Content="删除" Style="{StaticResource AliasAction}" Click="DeleteAlias"/></StackPanel>
        </Grid>
        <TextBlock x:Name="AliasStatus" Grid.Row="3" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>
</UserControl>