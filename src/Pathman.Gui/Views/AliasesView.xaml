<UserControl x:Class="Pathman.Gui.Views.AliasesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="刷新" Click="Refresh" Padding="14,6"/><TextBlock Text="程序别名" FontSize="24" FontWeight="SemiBold"/></DockPanel>
        <ListView x:Name="Aliases" Grid.Row="1" Background="{DynamicResource CardBackground}" AutomationProperties.Name="程序别名列表"><ListView.View><GridView><GridViewColumn Header="别名" DisplayMemberBinding="{Binding Name}" Width="180"/><GridViewColumn Header="目标程序" DisplayMemberBinding="{Binding Target}" Width="570"/></GridView></ListView.View></ListView>
        <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="BinPath" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="ShimsPath" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
    </Grid>
</UserControl>
