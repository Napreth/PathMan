<UserControl xmlns:loc="clr-namespace:Pathman.Gui.Controls" x:Class="Pathman.Gui.Views.VersionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pathman.Gui.Controls">
    <UserControl.Resources>
        <Style x:Key="VersionList" TargetType="ListBox"><Setter Property="SelectionMode" Value="Extended"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem" BasedOn="{StaticResource CompactListItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></Setter.Value></Setter></Style>
        <Style x:Key="Cell" TargetType="controls:EditableRow"><Setter Property="ShowPin" Value="False"/><Setter Property="ShowEdit" Value="False"/><Setter Property="ShowDelete" Value="False"/><Setter Property="SeparateEditors" Value="True"/><Setter Property="CommitOnLostFocus" Value="False"/><Setter Property="CanEdit" Value="{Binding CanEdit}"/></Style>
        <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource SettingsIconButton}"><Setter Property="Width" Value="23"/><Setter Property="Height" Value="22"/><Setter Property="FontSize" Value="12"/><Setter Property="Tag" Value="defer"/></Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="6,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13"/></Style>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{loc:Translate '版本管理'}" Style="{StaticResource PageTitle}" Margin="0,0,0,24"/>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,6"><TextBlock Text="{loc:Translate '项目'}" Style="{StaticResource SectionTitle}"/><Button x:Name="NewProjectButton" HorizontalAlignment="Right" Content="&#xE710;" Style="{StaticResource SettingsIconButton}" ToolTip="{loc:Translate '新建项目'}" AutomationProperties.Name="{loc:Translate '新建项目'}" Click="NewProject"/></Grid>
            <TextBlock Grid.Column="2" x:Name="ProjectTitle" Text="{loc:Translate '版本'}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
            <Grid Grid.Row="1" Margin="18,0,39,8" Opacity="0.65"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Translate '名称'}" FontSize="12"/><TextBlock Grid.Column="1" Text="{loc:Translate '变量（范围）'}" FontSize="12"/></Grid>
            <Grid Grid.Row="1" Grid.Column="2" Margin="18,0,18,8" Opacity="0.65"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Translate '版本'}" FontSize="12"/><TextBlock Grid.Column="1" Text="{loc:Translate '变量值'}" FontSize="12" Margin="12,0,0,0"/></Grid>
            <Border Grid.Row="2" Style="{StaticResource Surface}"><ListBox x:Name="ProjectsList" Style="{StaticResource VersionList}" SelectionChanged="ProjectSelected" AutomationProperties.Name="{loc:Translate '版本项目'}">
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions>
                    <controls:EditableRow Tag="project" Text="{Binding Name}" EmptyPlaceholder="项目名称" Style="{StaticResource Cell}" RegionEditRequested="EditRegion" EditRequested="EditCell" EditingChanged="EditingChanged" EditingCanceled="EditingCanceled"/>
                    <Border Grid.Column="1" x:Name="TargetBinding" Background="Transparent" PreviewMouseLeftButtonDown="BindingMouseDown" ToolTip="{Binding BindingText}" AutomationProperties.Name="{Binding BindingText}"><TextBlock Text="{Binding BindingText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
                    <Button Grid.Column="2" x:Name="DeleteProjectButton" Content="&#xE74D;" Style="{StaticResource RowIcon}" ToolTip="{loc:Translate '删除项目配置，保留当前变量'}" AutomationProperties.Name="{loc:Translate '删除项目'}" Click="DeleteProject"/>
                </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox></Border>
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Surface}"><ListBox x:Name="VersionsList" Style="{StaticResource VersionList}" SelectionChanged="VersionSelected" AutomationProperties.Name="{loc:Translate '可用版本'}">
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <controls:EditableRow Tag="version" Text="{Binding Name}" Detail="{Binding Value}" NameWidth="80" EmptyPlaceholder="版本名" Style="{StaticResource Cell}" RegionEditRequested="EditRegion" EditRequested="EditCell" EditingChanged="EditingChanged" EditingCanceled="EditingCanceled"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentLabel}" FontSize="11" Margin="6,0,4,0" VerticalAlignment="Center"/>
                </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox></Border>
            <Grid Grid.Row="2" Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel>
                <Button x:Name="AddVersionButton" Content="{loc:Translate '新建'}" Style="{StaticResource Action}" AutomationProperties.Name="{loc:Translate '新建版本'}" Click="AddVersion"/>
                <Button x:Name="RenameVersionButton" Content="{loc:Translate '重命名'}" Style="{StaticResource Action}" Click="RenameVersion"/>
                <Button x:Name="EditVersionButton" Content="{loc:Translate '编辑'}" Style="{StaticResource Action}" Click="EditVersion"/>
                <Button x:Name="BrowseVersionButton" Content="{loc:Translate '浏览…'}" Style="{StaticResource Action}" Tag="defer" Click="BrowseVersion"/>
                <Button x:Name="CopyVersionButton" Content="{loc:Translate '复制'}" Style="{StaticResource Action}" Click="CopyVersion"/>
                <Button x:Name="DeleteVersionButton" Content="{loc:Translate '删除'}" Style="{StaticResource Action}" Tag="defer" ToolTip="{loc:Translate '删除版本配置，保留当前值'}" Click="DeleteVersion"/>
            </StackPanel><Button x:Name="SwitchVersionButton" Grid.Row="2" Content="{loc:Translate '切换'}" Style="{StaticResource Action}" Margin="0" Click="SwitchVersion" ToolTip="{loc:Translate '将选中版本写入目标变量'}"/></Grid>
            <TextBlock x:Name="CurrentValue" Grid.Row="3" Grid.Column="2" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <TextBlock x:Name="VersionStatus" Grid.Row="2" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>
</UserControl>
