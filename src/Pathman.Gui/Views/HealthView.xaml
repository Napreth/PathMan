<UserControl x:Class="Pathman.Gui.Views.HealthView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pathman.Gui.Controls">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24"><Button x:Name="ScanButton" DockPanel.Dock="Right" Content="重新检测" Click="Scan" Padding="16,5"/><TextBlock Text="健康检测" Style="{StaticResource PageTitle}"/></DockPanel>
        <Border x:Name="SummarySurface" Grid.Row="1" Style="{StaticResource Surface}" Padding="20,16" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="Summary" Text="正在检测…" FontSize="18"/><TextBlock x:Name="ScanTime" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel></Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <ListBox x:Name="IssueGroups" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Surface}" Padding="20,16" Margin="0,0,0,12"><StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" Margin="0,0,0,12"/>
                    <ListBox ItemsSource="{Binding Issues}" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Symbol}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1"><controls:Osc8TextBlock Body="{Binding Body}" FontSize="14"/><controls:ReferenceText Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate></ListBox>
                </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
