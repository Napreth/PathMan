<UserControl x:Class="Pathman.Gui.Controls.ScopeActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="DeleteButton" Style="{StaticResource SettingsIconButton}" Content="&#xE74D;" ToolTip="删除" AutomationProperties.Name="删除" Click="Delete"/>
        <Button x:Name="RenameButton" Style="{StaticResource SettingsIconButton}" Content="&#xE70F;" ToolTip="重命名" AutomationProperties.Name="重命名" Click="Rename"/>
        <Grid MouseEnter="ShowMenu" MouseLeave="CloseMenu">
            <Button x:Name="NewButton" Style="{StaticResource SettingsIconButton}" AutomationProperties.Name="新建" Click="OpenMenu">
                <Grid Width="24" Height="22"><TextBlock Text="&#xE710;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
            </Button>
            <Popup x:Name="NewMenu" PlacementTarget="{Binding ElementName=NewButton}" Placement="Bottom" HorizontalOffset="-134" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="162" Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MouseLeave="CloseMenu">
                    <StackPanel><Button Content="新建分组" Click="NewGroup" HorizontalAlignment="Stretch" Padding="12,7" AutomationProperties.Name="新建分组"/><Button Content="新建环境变量" Click="NewVariable" HorizontalAlignment="Stretch" Padding="12,7" AutomationProperties.Name="新建环境变量"/></StackPanel>
                </Border>
            </Popup>
        </Grid>
    </StackPanel>
</UserControl>
