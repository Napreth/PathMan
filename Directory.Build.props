<Project>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>PathMan</Company>
    <Product>PathMan</Product>
    <PathManVersionName Condition="'$(PathManVersionName)' == ''">1.0.0-beta.1</PathManVersionName>
    <PathManVersionX>0</PathManVersionX>
    <PathManVersionY>0</PathManVersionY>
    <PathManVersionNumber Condition="'$(PathManVersionNumber)' == ''">$(PathManVersionX).$(PathManVersionY).0</PathManVersionNumber>
    <PathManReleaseType Condition="'$(PathManReleaseType)' == ''">beta</PathManReleaseType>
    <Version>$(PathManVersionNumber)</Version>
    <AssemblyVersion>$(PathManVersionNumber).0</AssemblyVersion>
    <FileVersion>$(PathManVersionNumber).0</FileVersion>
    <InformationalVersion>$(PathManVersionName)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <AssemblyMetadata Include="PathMan.VersionName" Value="$(PathManVersionName)" />
    <AssemblyMetadata Include="PathMan.VersionNumber" Value="$(PathManVersionNumber)" />
    <AssemblyMetadata Include="PathMan.ReleaseType" Value="$(PathManReleaseType)" />
  </ItemGroup>
</Project>
